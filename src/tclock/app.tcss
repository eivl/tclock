Screen {
    align: center middle;
    overflow: hidden hidden;
    layers: base keybar;
}

Screen.-flash {
    background: ansi_green;
}

Screen.-flash Label {
    color: ansi_black;
}

#body {
    height: auto;
    overflow: hidden hidden;
}

#header, #footer {
    width: 100%;
    text-align: center;
}

#header {
    margin-bottom: 1;
}

#footer {
    margin-top: 1;
}

/* The key bar sits on its own layer so showing it never moves the digits. */
#keybar {
    layer: keybar;
    dock: bottom;
}

HelpScreen {
    align: center middle;
    background: $background 60%;
}

HelpScreen > #help {
    width: auto;
    height: auto;
    padding: 1 2;
    border: round $primary;
    border-title-align: center;
}

HelpScreen #help-keys {
    width: auto;
    height: auto;
}
